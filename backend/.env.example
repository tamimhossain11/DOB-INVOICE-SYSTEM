# Copy to .env and change these values before deploying.
PORT=3000

# Secret used to sign the admin session cookie. Use a long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# The single admin account created on first run.
ADMIN_EMAIL=admin@dreamsofbangladesh.com
ADMIN_PASSWORD=ChangeMe123!

# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
# Railway, Fly and anything behind Let's Encrypt should use 1.
SECURE_COOKIE=0

# Where invoices.db is stored. Leave unset locally (defaults to backend/data).
# On a host with a persistent volume, point this at the mount path, e.g. /data
# DATA_DIR=/data
